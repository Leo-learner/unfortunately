PORT=3210
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3210
# The owner's commenter identity (站长); existing 站长 comments keep this email.
ADMIN_EMAIL=your-email@example.com
SESSION_SECRET=replace-with-64-random-hex-characters
DATABASE_PATH=./data/unfortunately.sqlite
# Shared dkz12345 sign-in (Clerk). Public values only: the publishable key and
# the instance's JWT public key; the Clerk secret key never goes on the server.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_JWT_KEY_FILE=./deploy/clerk-dkz12345.pem
# The one Clerk account that administers the site (user_...).
OWNER_CLERK_USER_ID=
# Optional: path to a SHA-256 digest of a separate MCP administrator key.
MCP_ADMIN_KEY_HASH_FILE=
