[Unit]
Description=Back up Unfortunately journal
After=unfortunately.service

[Service]
Type=oneshot
User=leo
Group=leo
WorkingDirectory=/opt/apps/unfortunately/current
ExecStart=/usr/bin/node deploy/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apps/unfortunately/shared/data
